{
  "name": "pi-lead",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetienne/pi-lead.git"
  },
  "homepage": "https://github.com/tetienne/pi-lead#readme",
  "bugs": {
    "url": "https://github.com/tetienne/pi-lead/issues"
  },
  "files": [
    ".agents/skills/",
    "README.md",
    "src/",
    "sandbox/"
  ],
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": "24.14.1"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "sandbox:image": "node sandbox/build-image.ts",
    "sandbox:smoke": "node sandbox/smoke.ts"
  },
  "pi": {
    "extensions": [
      "./src/lead.ts"
    ]
  },
  "dependencies": {
    "@earendil-works/gondolin": "0.12.0",
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "24.10.0",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
