{
  "name": "pi-lead",
  "version": "0.7.0",
  "description": "A Pi package that turns one Pi session into an engineering lead delegating to worker Pi processes.",
  "license": "MIT",
  "author": "Thibaut Etienne",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetienne/pi-lead.git"
  },
  "homepage": "https://github.com/tetienne/pi-lead#readme",
  "bugs": {
    "url": "https://github.com/tetienne/pi-lead/issues"
  },
  "files": [
    ".agents/skills/",
    "README.md",
    "src/",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "agents"
  ],
  "engines": {
    "node": ">=23.6.0"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./src/lead.ts"
    ]
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "24.10.0",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
